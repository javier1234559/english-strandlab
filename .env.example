# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_ENV=development

# Public HTTPS origin for ChatGPT iframe widget (ngrok / production).
# Required so MCP Apps can fetch / and load /_next assets inside ChatGPT.
# Example: BASE_URL=https://english-strandlab.vercel.app
BASE_URL=
NEXT_PUBLIC_BASE_URL=

# ─── Google Sheets (NEW StrandLab spreadsheet — not the old vocab-quiz sheet)
# 1) Create a new Google Sheet
# 2) Extensions → Apps Script → paste google-apps-script/Code.gs
# 3) Project Settings → Script properties → SYNC_TOKEN = <secret>
# 4) Deploy → New deployment → Web app → Anyone
# 5) Fill values below into .env.local and restart pnpm dev
# 6) In the app: Setup Sheet tabs → Sync Sheet

NEXT_PUBLIC_SHEETS_WEB_APP_URL=
NEXT_PUBLIC_SYNC_TOKEN=
NEXT_PUBLIC_GOOGLE_SHEET_URL=

# Server-only Footnote MCP data source. Do not expose these in browser code.
SHEETS_WEB_APP_URL=
SYNC_TOKEN=
